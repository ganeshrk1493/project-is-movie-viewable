config {
  type: "operations",
  hasOutput: true,
  schema: "movie_gold",
  name: "vertex_ai_models",
  description: "Registers BigQuery ML remote models for Gemini 3.5 Flash text generation and regional text embeddings."
}

CREATE OR REPLACE MODEL `project-is-movie-viewable.movie_gold.gemini_flash_model`
REMOTE WITH CONNECTION `project-is-movie-viewable.asia-south1.vertex-ai-conn`
OPTIONS (
  ENDPOINT = 'https://asia-south1-aiplatform.googleapis.com/v1/projects/project-is-movie-viewable/locations/asia-south1/publishers/google/models/gemini-3.5-flash-lite'
);

CREATE OR REPLACE MODEL `project-is-movie-viewable.movie_gold.text_embedding_model`
REMOTE WITH CONNECTION `project-is-movie-viewable.asia-south1.vertex-ai-conn`
OPTIONS (
  ENDPOINT = 'gemini-embedding-001'
);